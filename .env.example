# Copy to .env and fill in. Never commit a filled .env.

# ---- Site ----
# Required on deploy: the email allowed to claim the owner desk on first
# sign-in (case-insensitive). Without it, the first signed-in visitor owns
# the desk. See claimOrRequireOwner in src/lib/cms/db.ts.
OWNER_EMAIL=you@example.com

# Optional: enables the N3xUs Core assistant and lab bot demos (api.x.ai).
XAI_API_KEY=

# ---- Auth ----
# "false" (the shipped default) disables auth: a shared dev user is used and
# no database is touched. Deploys set "true" with DATABASE_URL.
VITE_AUTH_ENABLED=false

# Public origin of the deployed app (needed when VITE_AUTH_ENABLED=true).
BETTER_AUTH_URL=https://your-domain.com

# Per-app broker credentials injected by the deployer (override the shared
# live-preview client baked into src/lib/auth/preview.ts).
GROK_AUTH_ISSUER=
GROK_AUTH_CLIENT_ID=
GROK_AUTH_CLIENT_SECRET=

# Optional override for the baked preview client secret (must match the
# broker's GROK_PREVIEW_CLIENT_SECRET). The live preview does not read env,
# so this only takes effect on deploys / local runs.
PREVIEW_CLIENT_SECRET=

# ---- Database ----
# Postgres connection string. Unset -> the embedded PGLite fallback is used
# (data lives in-process; fine for preview, not for production).
DATABASE_URL=
